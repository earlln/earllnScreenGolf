<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 이름이 뽑힐 때마다 짧게 진동 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 결제 권한(com.android.vending.BILLING)은 Play Billing 라이브러리가 넣어준다. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenGolf">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MembersActivity"
            android:exported="false"
            android:label="@string/members_title"
            android:theme="@style/Theme.ScreenGolf.Bar" />

        <activity
            android:name=".PairsActivity"
            android:exported="false"
            android:label="@string/pairs_title"
            android:theme="@style/Theme.ScreenGolf.Bar" />

        <activity
            android:name=".DrawActivity"
            android:exported="false"
            android:label="@string/draw_title"
            android:theme="@style/Theme.ScreenGolf.Bar" />

        <activity
            android:name=".ResultActivity"
            android:exported="false"
            android:label="@string/result_title"
            android:theme="@style/Theme.ScreenGolf.Bar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.ScreenGolf.Bar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
